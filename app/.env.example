# Local FastAPI gateway. The browser calls this origin only.
# Example: http://127.0.0.1:8000
# Leave it empty to run the UI with Review code disabled.
# Do not put the Jetson address, the Ollama URL, a vLLM URL, a token, or a password here.
# Vite exposes every VITE_ variable to the browser.
# The gateway allows the dev origins http://localhost:5173 and http://127.0.0.1:5173.
VITE_API_BASE_URL=
